# ============================================
# 环境变量示例 —— 复制为 .env 并填入真实值
# 注意：.env 已被 .gitignore 忽略，不会提交到仓库
# ============================================

# 通联数据 (DataYes) API Token —— 必填，数据拉取脚本使用
DATAYES_TOKEN=在此填入你的通联数据 API Token

# 公网发布服务器 (5publish_public.py) 的 Basic Auth 凭据
AUTH_USER=sw
AUTH_PASS=在此填入你的发布密码
